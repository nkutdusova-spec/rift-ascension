:root {
  --cyan: #72e8ff;
  --blue: #2d8cff;
  --violet: #a765ff;
  --red: #ff4d68;
  --gold: #ffd36e;
  --panel: rgba(7, 15, 28, 0.9);
  --line: rgba(114, 232, 255, 0.28);
}

* { box-sizing: border-box; }

html, body {
  width: 100%;
  height: 100%;
  margin: 0;
  overflow: hidden;
  background: #03060d;
  color: #f4fbff;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

button { font: inherit; }

#gameShell {
  position: relative;
  width: 100vw;
  height: 100vh;
  min-height: 480px;
  overflow: hidden;
  background:
    radial-gradient(circle at 70% 30%, rgba(114, 54, 188, .2), transparent 35%),
    linear-gradient(#060915, #02040a);
}

#game {
  display: block;
  width: 100%;
  height: 100%;
  cursor: crosshair;
  touch-action: none;
}

.hidden { display: none !important; }

#hud {
  position: absolute;
  inset: 18px 20px auto 20px;
  display: grid;
  grid-template-columns: 1fr minmax(260px, 520px) 1fr;
  align-items: start;
  gap: 18px;
  pointer-events: none;
  text-shadow: 0 2px 8px #000;
}

.hud-left, .hud-right { display: flex; gap: 12px; align-items: flex-start; }
.hud-right { justify-content: flex-end; }

.rank-badge, .level-card, .weapon-card, #comboBox, #questBox {
  border: 1px solid var(--line);
  background: linear-gradient(135deg, rgba(10, 25, 44, .92), rgba(4, 9, 18, .88));
  box-shadow: 0 0 28px rgba(45, 140, 255, .12), inset 0 0 18px rgba(114, 232, 255, .04);
  backdrop-filter: blur(10px);
}

.rank-badge {
  width: 74px;
  height: 74px;
  display: grid;
  place-items: center;
  align-content: center;
  clip-path: polygon(50% 0, 94% 22%, 94% 78%, 50% 100%, 6% 78%, 6% 22%);
}

.rank-badge span { font-size: 31px; font-weight: 900; color: var(--cyan); line-height: .95; }
.rank-badge small, .weapon-card small { font-size: 9px; letter-spacing: .18em; opacity: .7; }

.bars { width: min(430px, 36vw); padding-top: 2px; }
.bar-row { display: grid; grid-template-columns: 28px 1fr 76px; align-items: center; gap: 8px; margin-bottom: 7px; font-size: 10px; font-weight: 800; }
.bar-row b { font-weight: 700; opacity: .85; text-align: right; }
.bar { position: relative; height: 11px; overflow: hidden; border: 1px solid rgba(255,255,255,.16); background: rgba(0,0,0,.55); transform: skewX(-14deg); }
.bar i { display: block; width: 100%; height: 100%; background: linear-gradient(90deg, #a61639, var(--red)); box-shadow: 0 0 15px rgba(255,77,104,.7); transition: width .18s ease; }
.bar.mana i { background: linear-gradient(90deg, #194ac9, var(--cyan)); box-shadow: 0 0 15px rgba(114,232,255,.65); }
.bar.xp i { background: linear-gradient(90deg, #6640c8, var(--violet)); box-shadow: 0 0 15px rgba(167,101,255,.7); }

.hud-center { text-align: center; }
#comboBox { display: inline-block; padding: 7px 14px; font-size: 10px; letter-spacing: .16em; opacity: 0; transform: translateY(-12px); transition: .2s; }
#comboBox.show { opacity: 1; transform: translateY(0); }
#comboBox strong { color: var(--gold); font-size: 17px; margin-left: 4px; }
#bossWrap { margin-top: 8px; }
#bossName { font-size: 11px; letter-spacing: .25em; margin-bottom: 5px; color: #ffe9e9; }
.boss-bar { height: 14px; border: 1px solid rgba(255,255,255,.25); background: rgba(0,0,0,.65); overflow: hidden; }
.boss-bar i { display: block; height: 100%; width: 100%; background: linear-gradient(90deg, #741523, #ff4d68); box-shadow: 0 0 20px rgba(255,77,104,.8); transition: width .12s linear; }

.level-card { padding: 10px 12px; letter-spacing: .12em; }
.level-card strong { color: var(--cyan); font-size: 22px; }
.weapon-card { min-width: 174px; padding: 8px 12px; display: grid; }
.weapon-card strong { color: #e6faff; font-size: 12px; margin-top: 3px; }

#questBox {
  position: absolute;
  top: 106px;
  left: 22px;
  width: 300px;
  padding: 12px 14px;
  display: grid;
  border-left: 3px solid var(--cyan);
}
#questBox small { color: var(--cyan); letter-spacing: .18em; font-size: 9px; }
#questBox strong { font-size: 14px; margin: 4px 0; }
#questBox span { font-size: 11px; opacity: .74; }

#systemToast {
  position: absolute;
  left: 50%;
  top: 18%;
  width: min(480px, calc(100vw - 32px));
  padding: 14px 18px;
  display: grid;
  text-align: center;
  transform: translate(-50%, -30px);
  opacity: 0;
  pointer-events: none;
  border: 1px solid rgba(114, 232, 255, .5);
  background: linear-gradient(90deg, rgba(7,20,36,.04), rgba(8,26,45,.94), rgba(7,20,36,.04));
  box-shadow: 0 0 40px rgba(45,140,255,.18);
  transition: opacity .25s, transform .25s;
}
#systemToast.show { opacity: 1; transform: translate(-50%, 0); }
#systemToast small { color: var(--cyan); letter-spacing: .28em; font-size: 9px; }
#systemToast strong { font-size: 18px; margin: 4px 0; letter-spacing: .06em; }
#systemToast span { opacity: .72; font-size: 12px; }

.overlay {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  padding: 24px;
  background: radial-gradient(circle at center, rgba(10,19,36,.6), rgba(1,3,8,.93));
  opacity: 0;
  visibility: hidden;
  transition: .25s;
  z-index: 20;
}
.overlay.active { opacity: 1; visibility: visible; }

.panel {
  width: min(760px, 94vw);
  padding: clamp(24px, 5vw, 52px);
  text-align: center;
  border: 1px solid rgba(114, 232, 255, .25);
  background:
    linear-gradient(135deg, rgba(13, 31, 55, .95), rgba(4, 9, 18, .97)),
    repeating-linear-gradient(90deg, transparent 0 40px, rgba(114,232,255,.03) 41px);
  box-shadow: 0 24px 100px rgba(0,0,0,.75), 0 0 45px rgba(45,140,255,.12);
  clip-path: polygon(22px 0, 100% 0, 100% calc(100% - 22px), calc(100% - 22px) 100%, 0 100%, 0 22px);
}

.eyebrow { color: var(--cyan); font-size: 10px; letter-spacing: .28em; font-weight: 800; }
h1 { margin: 8px 0 18px; font-size: clamp(42px, 8vw, 90px); line-height: .85; letter-spacing: -.07em; }
h1 span { color: transparent; -webkit-text-stroke: 1px var(--cyan); text-shadow: 0 0 24px rgba(114,232,255,.25); }
h2 { margin: 6px 0 8px; font-size: clamp(30px, 5vw, 52px); }
.story { max-width: 650px; margin: 0 auto 24px; color: #b8c7d8; line-height: 1.65; }

.instructions { display: flex; justify-content: center; flex-wrap: wrap; gap: 9px 18px; margin: 22px auto 28px; color: #a7b6c7; font-size: 12px; }
kbd { display: inline-grid; place-items: center; min-width: 29px; height: 25px; margin-right: 4px; padding: 0 7px; color: white; border: 1px solid rgba(255,255,255,.26); border-bottom-width: 3px; border-radius: 4px; background: rgba(255,255,255,.08); font-weight: 800; }

.primary-btn, .stat-grid button {
  border: 1px solid rgba(114,232,255,.55);
  color: #effcff;
  background: linear-gradient(135deg, rgba(23,112,175,.8), rgba(43,52,139,.9));
  box-shadow: 0 0 22px rgba(45,140,255,.18);
  cursor: pointer;
  transition: transform .15s, filter .15s, border-color .15s;
}
.primary-btn { min-width: 220px; padding: 14px 20px; font-weight: 900; letter-spacing: .12em; }
.primary-btn:hover, .stat-grid button:hover { transform: translateY(-2px); filter: brightness(1.18); border-color: white; }
.text-btn { display: block; margin: 14px auto 0; border: 0; color: #8090a3; background: none; cursor: pointer; font-size: 11px; }
.text-btn:hover { color: white; }

.level-panel > p:not(.eyebrow) { color: #91a2b5; }
.stat-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; margin-top: 26px; }
.stat-grid button { position: relative; min-height: 150px; padding: 18px 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.stat-grid button strong { color: var(--cyan); font-size: 24px; }
.stat-grid button span { min-height: 36px; margin: 8px 0; font-size: 10px; color: #c2d0df; }
.stat-grid button b { font-size: 22px; color: var(--gold); }
.end-panel { max-width: 570px; }

#touchControls { display: none; position: absolute; inset: auto 12px 16px; justify-content: space-between; z-index: 8; pointer-events: none; }
#touchControls > div { display: flex; gap: 8px; pointer-events: auto; }
#touchControls button { width: 58px; height: 58px; border-radius: 50%; border: 1px solid rgba(114,232,255,.35); background: rgba(7,17,31,.72); color: white; font-size: 11px; font-weight: 900; backdrop-filter: blur(6px); touch-action: none; }
#touchControls button:active { background: rgba(45,140,255,.7); }

@media (max-width: 850px) {
  #hud { grid-template-columns: 1fr 1fr; }
  .hud-center { grid-column: 1 / -1; grid-row: 2; }
  .bars { width: 40vw; }
  .weapon-card { display: none; }
  #questBox { top: 100px; width: 250px; }
  .stat-grid { grid-template-columns: repeat(2, 1fr); }
  .stat-grid button:last-child { grid-column: 1 / -1; }
}

@media (pointer: coarse), (max-width: 700px) {
  #touchControls { display: flex; }
  .instructions { display: none; }
  .intro-panel { padding-bottom: 100px; }
  #questBox { top: 92px; left: 10px; transform: scale(.88); transform-origin: top left; }
  #hud { inset: 10px; }
  .rank-badge { width: 56px; height: 56px; }
  .bars { width: 52vw; }
  .bar-row { grid-template-columns: 24px 1fr; }
  .bar-row b { display: none; }
  .level-card { padding: 7px 9px; }
}
